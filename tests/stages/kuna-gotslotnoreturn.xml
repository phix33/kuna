<stringmatch name="GOT slot no-return #1: die, whose exit goes through the GOT slot, is no-return to its caller, as through the PLT" min="2" max="2">die\(\); // no-return</stringmatch>
<stringmatch name="GOT slot no-return #2: die2, which calls exit through the slot on both paths, is no-return, as through the PLT" min="2" max="2">die2\(a0\); // no-return</stringmatch>
<stringmatch name="The call through the interposable wrapper's slot keeps its store and return" min="1" max="1">\(\*dat_[0-9a-f]+\)\(\);
seen = a0;
return 0xb;</stringmatch>
<stringmatch name="GOT slot no-return #4: no caller runs on past a no-return wrapper into the next function" min="0" max="0">funcboundflow</stringmatch>
<stringmatch name="The nonzero error arm ends at the call, with the store on the returning path" min="2" max="2">error\(1,0,"bad %d".*; // no-return
seen = a0;
return a0 \* 3;</stringmatch>
<stringmatch name="The terminal call supplies no result to the caller" min="0" max="0">= error\(</stringmatch>
<stringmatch name="Both returning g paths retain the int result" min="2" max="2">^int4 g\(</stringmatch>
<stringmatch name="GOT slot no-return #6: control: maybe, which exits on one path only, stays returning in both images" min="2" max="2">^ *maybe\([^)]*\);$</stringmatch>
<stringmatch name="GOT slot no-return #7: control: drop, a tail jump to free through its slot, stays returning in both images" min="2" max="2">^ *drop\([^)]*\);$</stringmatch>
<stringmatch name="A branch can bypass the nonzero definition" min="1" max="1">return 0x29;</stringmatch>
<stringmatch name="The high half of RDI is outside the status argument" min="1" max="1">return 0x2a;</stringmatch>
<stringmatch name="XADD writes the second operand" min="1" max="1">return 0x2b;</stringmatch>
<stringmatch name="The underscored ELF import returns" min="1" max="1">__error\(7\);
return 0x2c;</stringmatch>
<stringmatch name="A stable slot and a reaching nonzero definition end the path" min="1" max="1">error\(7,0,"status"\); // no-return</stringmatch>
<stringmatch name="A writable error slot retains fall-through for the same instructions" min="1" max="1">return 0x2d;</stringmatch>
<stringmatch name="i386 status is the stack argument even when EDI is nonzero" min="1" max="1">error\(0,0,"stack status"\);
return 0x2f;</stringmatch>
